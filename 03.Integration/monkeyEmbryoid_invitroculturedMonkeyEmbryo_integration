library(Seurat)
library(harmony)

sc_list <- readRDS("../../cr6ncbi_d17tod28_nFatureRNA1000_Singlet_nCountRNA30000.rds")
sc_list <- subset(sc_list, orig.ident %in% 
                    c("d17_1_cr6","d18_1_cr6","d21_1_cr6","d22_1_cr6",
                      "d23_1","d25_1_cr6","d25_2_cr6"))
new <- sc_list
new_counts <- new@assays$RNA@counts
new_meta <- new@meta.data


# load monkey ex vivo data
load("../../public_data/Figure2_Allcells.Rdata")
gong <- Vitro
rm(Vitro);gc()
gong_counts <-  gong@assays$RNA@counts
gong_meta <- gong@meta.data

sharedGs <- intersect(row.names(new_counts), row.names(gong_counts) )

new_counts <- new_counts[sharedGs,]
gong_counts <- gong_counts[sharedGs,]

new_meta_sub <- new_meta[,c(1,2,3,9)]
colnames(new_meta_sub) <- c("sample","nCount_RNA","nFeature_RNA","annotation")
new_meta_sub$study <- rep("blastoid",nrow(new_meta_sub))

gong_meta_sub <- gong_meta[,c(4,2,3,5)]
colnames(gong_meta_sub) <- c("sample","nCount_RNA","nFeature_RNA","annotation")
gong_meta_sub$study <- rep("exvivo",nrow(gong_meta_sub))


blastoid <- CreateSeuratObject(counts = new_counts,meta.data = new_meta_sub)
blastoid$orig.ident <- blastoid$sample
Idents(blastoid) <- 'orig.ident'

exvivo <- CreateSeuratObject(counts = gong_counts,meta.data = gong_meta_sub)
exvivo$orig.ident <- exvivo$sample
Idents(exvivo) <- 'orig.ident'
levels(exvivo) <- sort(unique(exvivo$orig.ident))

sc_list =list(blastoid=blastoid, exvivo=exvivo)
save(sc_list, file = "raw_mfas_blastoid_d17-d25-2nod22-2_exvivo_sc_list.RData")


rm(list=ls())
load("raw_mfas_blastoid_d17-d25-2nod22-2_exvivo_sc_list.RData")


sc_list <- lapply(X = sc_list, FUN = function(x) {
  x <- NormalizeData(x)
  x <- FindVariableFeatures(x, selection.method = "vst", nfeatures = 3000)
  return(x)
})

features <- SelectIntegrationFeatures(object.list = sc_list, nfeatures = 3000)
sc_anchors <- FindIntegrationAnchors(object.list = sc_list, anchor.features = features)
save(sc_anchors, file = "mfas_blastoid_d17-d25-2nod22-2_exvivo_sc_anchors.RData")

# this command creates an 'integrated' data assay
sc_combined <- IntegrateData(anchorset = sc_anchors)
save(sc_combined,file="mfas_blastoid_d17-d25-2nod22-2_exvivo_sc_combined0.RData")



